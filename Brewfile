# Dotfiles dependencies
# Install with: brew bundle

# Shell tools
brew "zsh"
brew "starship"        # prompt
brew "zoxide"          # smart cd
brew "eza"             # modern ls
brew "bat"             # modern cat
brew "fzf"             # fuzzy finder
brew "ripgrep"         # fast grep

# Editors & terminal
brew "neovim"
brew "tmux"
cask "kitty"

# Development
brew "git"
brew "gh"              # GitHub CLI
brew "mise"            # runtime version manager (replaces asdf)
brew "pnpm"
brew "node"

# Optional
# cask "wezterm"       # alternative terminal
# brew "lazygit"       # git TUI
